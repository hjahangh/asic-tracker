# Local development: prefer python3 scripts/bootstrap_dev.py to generate all
# independent URI-safe passwords and secrets/mongodb-keyfile. Do not commit them.
MONGODB_DATABASE=asic_tracker_dev
MONGO_ROOT_USER=tracker_root
MONGO_ROOT_PASSWORD=replace_with_a_unique_random_uri_safe_password
MONGODB_OWNER_USER=tracker_owner
MONGODB_OWNER_PASSWORD=replace_with_another_random_uri_safe_password
MONGODB_RUNTIME_USER=tracker_app
MONGODB_RUNTIME_PASSWORD=replace_with_a_third_random_uri_safe_password
MONGODB_KEYFILE=./secrets/mongodb-keyfile
HTTP_PORT=8080
