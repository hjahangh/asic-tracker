# Copy to .env.production (ignored by Git). No credentials belong in this file.
# Replace with the image built and scanned by your internal pipeline.
ASIC_TRACKER_IMAGE=your-internal-registry/asic-tracker:approved-tag
TRACKER_HOSTNAME=tracker.internal.example
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
DATABASE_URL_SECRET_FILE=./secrets/runtime_database_url.txt
MIGRATION_DATABASE_URL_SECRET_FILE=./secrets/migration_database_url.txt
PROXY_SHARED_SECRET_FILE=./secrets/proxy_shared_secret.txt
ROLE_GROUPS={"viewer":["asic-tracker-viewers"],"editor":["asic-tracker-editors"],"admin":["asic-tracker-admins"]}
